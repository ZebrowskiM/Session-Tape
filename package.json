{
  "name": "session-tape",
  "productName": "Session Tape",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local desktop notebook for debugging and research.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "typescript": "5.9.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
